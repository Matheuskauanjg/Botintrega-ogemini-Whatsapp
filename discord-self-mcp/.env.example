PORT=10000
BRIDGE_INTERNAL_PORT=10001
PUBLIC_BASE_URL=https://your-service.up.railway.app
API_TOKEN=generate-a-long-random-secret
MCP_LOGIN_SECRET=generate-another-long-random-secret
MCP_CLIENT_ID=chatgpt-meu-discord

# Configure this only as a Railway secret. Never commit a real token.
DISCORD_USER_TOKEN=

# Optional: enables voice-message/audio transcription.
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIBE_LANGUAGE=pt
MAX_MEDIA_BYTES=10485760
