PORT=10000
BRIDGE_INTERNAL_PORT=10001
PUBLIC_BASE_URL=https://meu-discord-ml36.onrender.com
API_TOKEN=generate-a-long-random-secret
MCP_LOGIN_SECRET=generate-another-long-random-secret
MCP_CLIENT_ID=chatgpt-meu-discord

# Configure secrets only in Render. Never commit a real token.
DISCORD_USER_TOKEN=

# Optional: enables voice-message/audio transcription.
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIBE_LANGUAGE=pt
MAX_MEDIA_BYTES=10485760

# Optional: Greed auto-replies in the chat channel (set Render environment).
AUTO_REPLY_GUILD_ID=1251266361569710222
AUTO_REPLY_CHANNEL_ID=1554920683786739712
AUTO_REPLY_TRIGGERS=grade,greed
# Responde a @menções e mensagens que respondem ao próprio bot em qualquer canal.
# Conversa iniciada pode continuar por 7 minutos sem nova marcação.
AUTO_REPLY_CONVERSATION_SECONDS=420

# Playful flirting with Dogão when he calls Greed or somebody explicitly requests it.
# Optional: put Dogão's real Discord user ID here if he changes nicknames.
DOGAO_FLIRT_ENABLED=true
DOGAO_USER_ID=

# Failover tuning: 2 attempted Gemini models per API key instead of a long cascade.
GEMINI_MAX_ATTEMPTS=2
GEMINI_HTTP_TIMEOUT_SECONDS=16


# Publica a cada duas horas uma notícia chinesa no canal indicado.
# Ordem rotativa: 国内 (nacional), 地方 (províncias), 娱乐 (celebridades/fofocas).
# Tradução PT-BR: reutiliza Gemini / NVIDIA / Groq já configurados no bridge.
CHINA_NEWS_ENABLED=true
CHINA_NEWS_CHANNEL_ID=1560415874114920559
CHINA_NEWS_INTERVAL_SECONDS=7200
CHINA_NEWS_MAX_AGE_HOURS=96
CHINA_NEWS_EXTERNAL_IMAGES=true
CHINA_NEWS_MENTIONS_ENABLED=true
CHINA_NEWS_MENTION_TIME_ZONE=America/Sao_Paulo
CHINA_NEWS_MAX_MENTIONS_PER_POST=2
# JSON opcional com IDs do Discord e interesses (uma menção por pessoa/dia).
# CHINA_NEWS_MENTION_RULES={"123456789012345678":["足球","世界杯","futebol"],"987654321098765432":["电影","cinema"]}
CHINA_NEWS_DB_PATH=/data/china_news.sqlite3

# Publicação manual com !noticia e opções nacional / provincia / fofoca.
CHINA_NEWS_GUILD_ID=1251266361569710222
CHINA_NEWS_ADMIN_IDS=
CHINA_NEWS_MANUAL_COOLDOWN_SECONDS=30
