PORT=10000
BRIDGE_INTERNAL_PORT=10001
PUBLIC_BASE_URL=https://meu-discord-ml36.onrender.com
API_TOKEN=generate-a-long-random-secret
MCP_LOGIN_SECRET=generate-another-long-random-secret
MCP_CLIENT_ID=chatgpt-meu-discord

# Configure secrets only in Render. Never commit a real token.
DISCORD_USER_TOKEN=

# Optional: enables voice-message/audio transcription.
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIBE_LANGUAGE=pt
MAX_MEDIA_BYTES=10485760

# Optional: Greed auto-replies in the chat channel (set Render environment).
AUTO_REPLY_GUILD_ID=1251266361569710222
AUTO_REPLY_CHANNEL_ID=1554920683786739712
AUTO_REPLY_TRIGGERS=grade,greed

# Playful flirting with Dogão when he calls Greed or somebody explicitly requests it.
# Optional: put Dogão's real Discord user ID here if he changes nicknames.
DOGAO_FLIRT_ENABLED=true
DOGAO_USER_ID=

# Failover tuning: 2 attempted Gemini models per API key instead of a long cascade.
GEMINI_MAX_ATTEMPTS=2
GEMINI_HTTP_TIMEOUT_SECONDS=16
